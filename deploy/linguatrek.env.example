# =============================================================================
# 语途（LinguaTrek）生产环境变量模板
#
# 用法：
#   Docker Compose：cp deploy/linguatrek.env.example .env && chmod 600 .env
#   VPS 裸机 systemd：复制内容到 /etc/linguatrek/env，chown ln:ln，chmod 600
# 绝不提交真实 .env；不要把任何 Key 写进 Dockerfile、docker-compose.yml 或文档。
# 完整说明见 docs/部署指南.md；本次上线的站点专用模板见
# deploy/production.env.example，执行步骤见
# docs/部署执行手册-linguatrekai.online.md。
# =============================================================================

# ---- 站点身份（部署脚本/preflight 使用；应用本身不读取 DOMAIN） ----
DOMAIN=ln.example.com

# ---- 站点与安全（HTTPS 上线必填） ----
# 精确到前端来源，逗号分隔；不要用 *。同域部署通常就一个值。
CORS_ORIGINS=https://ln.example.com
# HTTPS 必须为 1；本地 http://127.0.0.1:8000 预览时改成 0 或删掉。
COOKIE_SECURE=1
# 管理员邮箱（/api/admin/* 止血台）；逗号分隔，大小写不敏感；留空 = 无管理员。
ADMIN_EMAILS=you@example.com

# ---- 邀请/注册开关（G1 邀请制，specs/032） ----
# 默认 false = 公开注册关闭，注册必须填有效邀请码；true = G2 公开注册。
# 改完必须重启后端（启动时读取）。管理台只读展示，不提供运行时开关。
REGISTRATION_OPEN=false
# 与 REGISTRATION_OPEN=false 同时为 false = 完全关闭新账号创建（登录不受影响）。
INVITE_SIGNUP_ENABLED=true
# 管理员生成邀请码时的默认值：有效天数（1–90）与可用次数（1–10）。
INVITE_CODE_TTL_DAYS=30
INVITE_CODE_MAX_USES=1
# 可选：邀请码 HMAC pepper。数据库只存 SHA-256 摘要，不存明文。
# 生产建议设置一个长随机值（openssl rand -hex 32）；轮换会让所有旧码失效。
# INVITE_CODE_PEPPER=

# ---- 余额与 AI 计费（M3a，specs/034） ----
# 金额一律整数微美元（1 USD = 1,000,000 µUSD）。新用户默认赠送 $2.00。
SIGNUP_BONUS_MICRO_USD=2000000
# 管理员单次充/扣上限（默认 $100）；单次预占上限与安全边际、hold 租约。
MAX_ADMIN_BALANCE_DELTA_MICRO_USD=100000000
BILLING_RESERVE_MARGIN_PERCENT=20
BILLING_MAX_RESERVE_MICRO_USD=500000
BILLING_HOLD_TTL_SECONDS=1800
# 严格计费（M7a，specs/036）：生产必须 1（游客/缺价一律拒绝，登录用户预占+结算）。
BILLING_STRICT=1

# ---- 模型 ----
# 默认模型 id，必须是 backend/config.py 的 MODEL_CATALOG 里的值。
DEFAULT_MODEL=deepseek-chat
# 按目标语言的候选链（逗号分隔；代码里是 MODEL_ROUTE_<LANG>，没有单一
# MODEL_ROUTES 变量）。未配置 Key 的模型会被 llm.py 跳过，不中断启动。
# M7a：路线里只能放有可核实单价的模型（Qwen 缺价，已从越南语路线移除）。
MODEL_ROUTE_ZH_CN=deepseek-chat,gemini-2.5-flash
MODEL_ROUTE_VI_VN=deepseek-chat
# 大陆部署默认模型（DeepSeek）必填；Gemini 仅海外可选，大陆留空。
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Qwen：M7a 起默认不启用（缺可核实单价，严格计费会 503）。
# 补齐官方价到 model_prices 并加回路线后再配置。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 构建期变量（Docker Compose 会读取本文件做 build args） ----
# 生产必须改成 https://你的域名；改域名必须重新 docker compose build。
VITE_API_BASE=https://ln.example.com

# ---- 数据与安全杂项 ----
# 学习事件假名 HMAC 的盐：生产必填，生成：openssl rand -hex 32
EVENTS_PSEUDONYM_SALT=
# 可选：SSE 心跳间隔（秒）；反向代理空闲超时更短时才需要调小。
# SSE_HEARTBEAT_INTERVAL=15
# 可选：发布版本号，会写入 /healthz 的 version 字段。
APP_VERSION=2026.11.15

# ---- 路径：Docker 模式不用填（镜像内置 /data） ----
# 裸机 systemd 模式下取消注释并改用 /srv/ln 路径：
# DATA_DIR=/srv/ln/data
# AUTH_DB_PATH=/srv/ln/data/app.db
# USER_DATA_DIR=/srv/ln/data/users
# GUEST_DATA_DIR=/srv/ln/data/guests
# EXPORTS_DIR=/srv/ln/data/exports
# EXPORT_MAX_BYTES=209715200
# EXPORT_TTL_HOURS=24
# HISTORY_DIR=/srv/ln/data/history
# SUBTITLES_DIR=/srv/ln/subtitles
# SENTENCES_DIR=/srv/ln/current/content/sentences
# PLACEMENT_DIR=/srv/ln/current/content/placement
# EXAM_DIR=/srv/ln/current/content/exam
# CURATED_CONTENT_PATH=/srv/ln/current/content/curated.json
# BLOG_DIR=/srv/ln/current/content/blog
# LOCAL_DICT_PATH=/srv/ln/data/ecdict.db

# =============================================================================
# 以下变量请不要设置（除非明确知道后果）：见 docs/计划-上线部署.md P0-3
#   API_AUTH_KEY   —— 会拦截所有 /api（含 /api/auth/*），浏览器登录直接 401。
#                     公网浏览器多用户部署必须留空；仅移动端/内部客户端才考虑。
#   VITE_API_KEY   —— 会被打进前端 bundle，等于公开密钥。
#   BROWSER_UI=0   —— 只有不提供浏览器界面时才设。
# =============================================================================

# ---- 飞书告警（M5，specs/035-feishu-alerts） ----
# 默认关闭；只发一个群。webhook/secret 只放本机 env（chmod 600），
# 不要写进仓库、Dockerfile、docker-compose.yml、文档或截图。
# 开启：飞书群 → 设置 → 群机器人 → 添加自定义机器人 → 复制 webhook。
FEISHU_ALERTS_ENABLED=false
FEISHU_WEBHOOK_URL=
# 可选签名密钥；设置后请求体带 timestamp + HMAC-SHA256 sign。
# 服务器时间必须 NTP 同步，否则飞书会拒绝。
FEISHU_WEBHOOK_SECRET=
# 最低发送级别：P2（全发，默认）/ P1（P0+P1）/ P0（只 P0）。
FEISHU_ALERT_LEVEL=P2
# P0 @ 负责人：open_id（ou_xxx）或 all；留空不 @。
FEISHU_AT_USER_ID=
# text（默认）/ card（富文本卡片）。
FEISHU_ALERT_MESSAGE_FORMAT=text
# 同 event+key 去重窗口（秒，0=关闭）；P1 聚合窗口（秒）。
ALERT_DEDUPE_SECONDS=300
ALERT_P1_AGGREGATE_SECONDS=900
# 消息里的环境标签；P2 每日摘要整点（服务器本地时区）。
ALERT_ENV=prod
ALERT_DAILY_DIGEST_HOUR=9
# 管理员测试端点限流（次/分钟）。
RATE_LIMIT_ADMIN_ALERT_TEST_PER_MINUTE=3
#
# 外部巡检（cron，模板见 deploy/alert-check.cron）：
#   /srv/ln/current/backend/venv/bin/python /srv/ln/current/scripts/check-alerts.py
# 手工验证（不联网）：... scripts/check-alerts.py --self-test
