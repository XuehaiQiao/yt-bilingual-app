# =============================================================================
# 语途（LinguaTrek）生产环境变量模板 —— linguatrekai.online（G1 邀请制）
#
# 用法（Docker，推荐；完整步骤见 docs/部署执行手册-linguatrekai.online.md）：
#   cd /srv/ln/app
#   cp deploy/production.env.example .env
#   chmod 600 .env
#   ${EDITOR:-vi} .env
#
# 裸机 systemd：把本文件内容写到 /etc/linguatrek/env，并取消「裸机路径」段、
# 注释「Docker 路径」段；该文件权限 600、属主 ln:ln。
#
# 本文件只放变量名与占位，不包含任何真实密钥/密码/哈希。
# 绝不要提交真实 .env；不要写进 Dockerfile、docker-compose.yml、文档或截图。
# =============================================================================

# ---- 站点身份（部署脚本/preflight 使用；应用本身不读取 DOMAIN） ----
DOMAIN=linguatrekai.online

# ---- 构建期变量（Docker Compose 读取；改域名必须重新 build） ----
# 必须带 https://、不带尾斜杠。前端 bundle 会写死这个地址。
VITE_API_BASE=https://linguatrekai.online

# ---- 站点与安全（HTTPS 上线必填） ----
# 精确到前端来源，逗号分隔；不要用 *。www 会 301 到主域，所以只列主域。
CORS_ORIGINS=https://linguatrekai.online
# HTTPS 必须为 1；本地 HTTP 预览才改成 0。
COOKIE_SECURE=1
# 管理员邮箱（/api/admin/* 与邀请码管理）；逗号分隔，大小写不敏感。
# 必填：留空 = 没有管理员，无法在应用内生成邀请码/充值/处置账号。
# 例：ADMIN_EMAILS=you@example.com（逗号分隔可多个）
ADMIN_EMAILS=

# ---- 邀请/注册开关（G1 邀请制，specs/032） ----
# 公开注册关闭，新账号必须持有效邀请码。G1 网关（Caddy Basic Auth）已于 2026-11-20
# 移除，但公开注册仍保持 false：要开放必须另行评审，不能与摘网关一起顺手打开。
REGISTRATION_OPEN=false
# 与 REGISTRATION_OPEN=false 同时为 false = 完全关闭新账号创建（登录不受影响）。
INVITE_SIGNUP_ENABLED=true
# 管理员生成邀请码时的默认值（1–90 天 / 1–10 次）。
INVITE_CODE_TTL_DAYS=30
INVITE_CODE_MAX_USES=1
# 生产必填，生成：openssl rand -hex 32
# 轮换会让所有旧邀请码失效；数据库只存摘要，不存明文。
INVITE_CODE_PEPPER=

# ---- 学习事件假名盐（生产必填） ----
# 生成：openssl rand -hex 32
EVENTS_PSEUDONYM_SALT=

# ---- 模型与 Key ----
# 默认模型必须是 backend/config.py 的 MODEL_CATALOG 里的 id。
DEFAULT_MODEL=deepseek-chat
# 中文路线：DeepSeek 是 G1 默认；未配置 Key 的模型会被 llm.py 跳过。
MODEL_ROUTE_ZH_CN=deepseek-chat
# 越南语路线（M7a）：Qwen Flash/Plus 没有可核实官方价，严格计费下禁止调用
# （503 model_unpriced），因此路线只保留有价的 deepseek-chat。补 model_prices
# 官方价后才能把 Qwen 加回来。
MODEL_ROUTE_VI_VN=deepseek-chat
DEFAULT_MODEL_ZH_CN=deepseek-chat
DEFAULT_MODEL_VI_VN=deepseek-chat

# DeepSeek：中文主模型必填；只在服务端读取。
DEEPSEEK_API_KEY=
# Gemini：可选。香港出口能否稳定访问 Gemini 需在该 VPS 上实测；
# 不配置时下方路线不会使用它。不要因为“海外”就默认它可用。
GEMINI_API_KEY=
# Qwen：M7a 起默认不启用（缺可核实单价）。仅在你已把官方价写入 model_prices
# 并把它加回 MODEL_ROUTE_VI_VN 后才配置；Key 必须与端点同站。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 大陆站端点（仅当 Key 是大陆站时使用，二选一）：
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 余额与 AI 计费（M3a，specs/034） ----
# 金额一律整数微美元（1 USD = 1,000,000 µUSD）。新用户默认赠送 $2.00。
SIGNUP_BONUS_MICRO_USD=2000000
MAX_ADMIN_BALANCE_DELTA_MICRO_USD=100000000
BILLING_RESERVE_MARGIN_PERCENT=20
BILLING_MAX_RESERVE_MICRO_USD=500000
BILLING_HOLD_TTL_SECONDS=1800
# 严格计费（M7a，specs/036）：生产必须 1。AI 调用必须有登录用户 + 可核实单价，
# 预占/结算扣余额；缺价 503 model_unpriced，游客 403 login_required。
BILLING_STRICT=1

# ---- 数据路径：Docker 方式（镜像内置 /data，保持默认即可） ----
DATA_DIR=/data
AUTH_DB_PATH=/data/app.db
USER_DATA_DIR=/data/users
GUEST_DATA_DIR=/data/guests
HISTORY_DIR=/data/history
SUBTITLES_DIR=/data/subtitles
EXPORTS_DIR=/data/exports
SENTENCES_DIR=/app/content/sentences
PLACEMENT_DIR=/app/content/placement
EXAM_DIR=/app/content/exam
CURATED_CONTENT_PATH=/app/content/curated.json
BLOG_DIR=/app/content/blog
LOCAL_DICT_PATH=/data/ecdict.db
EXPORT_MAX_BYTES=209715200
EXPORT_TTL_HOURS=24

# ---- 数据路径：裸机 systemd 方式（Docker 方式不要启用本段） ----
# DATA_DIR=/srv/ln/data
# AUTH_DB_PATH=/srv/ln/data/app.db
# USER_DATA_DIR=/srv/ln/data/users
# GUEST_DATA_DIR=/srv/ln/data/guests
# HISTORY_DIR=/srv/ln/data/history
# SUBTITLES_DIR=/srv/ln/subtitles
# EXPORTS_DIR=/srv/ln/data/exports
# SENTENCES_DIR=/srv/ln/current/content/sentences
# PLACEMENT_DIR=/srv/ln/current/content/placement
# EXAM_DIR=/srv/ln/current/content/exam
# CURATED_CONTENT_PATH=/srv/ln/current/content/curated.json
# BLOG_DIR=/srv/ln/current/content/blog
# LOCAL_DICT_PATH=/srv/ln/data/ecdict.db

# ---- 运行期细节（可选；保持默认也可以） ----
# SSE 心跳（秒）：Cloudflare 100s / Nginx 60s 空闲超时会掐断长流，默认 15s 安全。
SSE_HEARTBEAT_INTERVAL=15
# 全局 LLM 并发；2C4G 机器不要调太高，先观察 CPU/内存与厂商限流。
LLM_MAX_CONCURRENCY=4
# 1 = 访问/异常日志一行一个 JSON（journald/docker logs 便于检索）。
LOG_JSON=1
# 发布版本号会写入 /healthz 的 version；发布时填 commit/tag，便于回滚核对。
APP_VERSION=

# ---- 飞书告警（M5，specs/035-feishu-alerts） ----
# 默认关闭；只发一个群。webhook/secret 只放本机 env（600），不要写进仓库、
# 日志、截图或前端。开启步骤见执行手册 §8。
FEISHU_ALERTS_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
FEISHU_ALERT_LEVEL=P2
FEISHU_AT_USER_ID=
FEISHU_ALERT_MESSAGE_FORMAT=text
ALERT_DEDUPE_SECONDS=300
ALERT_P1_AGGREGATE_SECONDS=900
ALERT_ENV=prod
ALERT_DAILY_DIGEST_HOUR=9
RATE_LIMIT_ADMIN_ALERT_TEST_PER_MINUTE=3

# ---- 发布/回滚辅助（Docker Compose 读取；不是应用变量） ----
# 首次构建前可不填（默认 latest）；发布时建议 export IMAGE_TAG=<commit或tag>。
# IMAGE_TAG=

# ---- 网关凭据：本文件不需要，也不要再加 ----
# 2026-11-20 起线上 Caddy 只做 TLS + 反代，Basic Auth 已从线上与仓库配置中删除：
# 不再生成/输入 g1 网关账号与哈希，访问控制只用应用内邀请码（见上面的开关）。
# /etc/caddy/g1.env 只需 ACME_EMAIL；应用不读取任何网关凭据。

# =============================================================================
# 不要设置（原因见 docs/部署指南.md §2.1）：
#   API_AUTH_KEY   —— 会拦截所有 /api（含 /api/auth/*），浏览器登录直接 401。
#   VITE_API_KEY   —— 会被打进前端 bundle，等于公开密钥。
#   BROWSER_UI=0   —— 只有不提供浏览器界面时才设。
# =============================================================================
