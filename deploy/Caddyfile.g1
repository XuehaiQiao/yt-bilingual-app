# =============================================================================
# 语途（LinguaTrek）G1 生产 Caddy 配置 —— linguatrekai.online
#
# 适用：VPS 裸机 / systemd 方式。Caddy 终止 TLS、直接服务 frontend/dist，
#       并把 /api/* 反代到 127.0.0.1:8000（uvicorn 单 worker）。
#
# Docker 方式不要用本文件：容器内已由 deploy/serve.py 服务静态文件与 SPA
# fallback，宿主机 Caddy 只需全量反代，见 deploy/Caddyfile.g1.proxy。
#
# 安装（完整步骤见 docs/部署执行手册-linguatrekai.online.md）：
#   sudo cp deploy/Caddyfile.g1 /etc/caddy/Caddyfile
#   sudo chown root:caddy /etc/caddy/Caddyfile
#   sudo chmod 640 /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile \
#        --envfile /etc/caddy/g1.env
#   sudo systemctl reload caddy
#
# 访问控制只在应用内（邀请码注册，REGISTRATION_OPEN=false + INVITE_SIGNUP_ENABLED=true）。
# Caddy 层不做认证、不加载任何网关凭据；不要在这里加认证块。
#
# Cloudflare：首次签发证书先设 DNS only（灰云）；橙云默认 100s 空闲超时，
# 必须确认后端 SSE 15s 心跳已生效并实测 30 分钟长流。
# =============================================================================
{
	# ACME 账号邮箱（证书到期提醒）。如不使用，删除本行也可。
	email {$ACME_EMAIL:ops@linguatrekai.online}
}

# www 301 到主域。
www.linguatrekai.online {
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	header -Server
	redir https://linguatrekai.online{uri} permanent
}

linguatrekai.online {
	encode zstd gzip

	# 安全头。逐行写、不用 header {} 块：Caddy 的 header 块会延迟到响应末尾，
	# 逐行写法对所有响应都生效（本机 Caddy 2.11.9 实测）。
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# CSP 与当前前端依赖一致：
	# - react-youtube 需要从 www.youtube.com / s.ytimg.com 加载 iframe API；
	# - framer-motion 使用内联样式，style-src 必须允许 'unsafe-inline'；
	# - PWA service worker 需要 worker-src 'self'。
	# 若以后启用博客 Giscus（VITE_GISCUS_* 构建期变量），还需把
	# https://giscus.app 加进 script-src 与 frame-src；当前未启用，不提前放宽。
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://s.ytimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://*.ytimg.com https://*.googleusercontent.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self'; font-src 'self' data:; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	# 尽量去掉 Server 头；某些错误响应下 Caddy 仍可能补回 Server: Caddy，
	# 属于低风险信息暴露，不作为验收失败项（见执行手册）。
	header -Server

	# 带内容哈希的构建产物可以长缓存；入口 HTML 与 SW 必须每次回源。
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@entry path / /index.html /sw.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"

	# 健康检查也走后端（它们不在 /api 下）。
	handle /healthz {
		reverse_proxy 127.0.0.1:8000
	}
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}

	# SSE 关键：关闭反向代理缓冲（flush_interval -1），读写超时拉长到 24h。
	# 后端每 15s 发一行 `: ping` 心跳（SSE_HEARTBEAT_INTERVAL，默认 15）。
	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
				response_header_timeout 24h
			}
		}
	}

	# SPA fallback：深链刷新返回 index.html。
	handle {
		root * /srv/ln/current/frontend/dist
		try_files {path} /index.html
		file_server
	}

	# 访问日志默认写 stdout，由 journald 收集（journalctl -u caddy）。
	# Caddy 默认会脱敏 Authorization/Cookie；这里再删除下载 URL 里的 token 等
	# 查询参数，避免一次性下载令牌进入日志。
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete access_token
					delete api_key
				}
			}
		}
	}
}
