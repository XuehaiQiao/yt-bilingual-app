# Default LLM for translation / summary / dictionary.
# Must be an id present in backend/config.py MODEL_CATALOG; empty or unknown
# values fall back to "deepseek-chat" (only a warning is printed).
# 默认模型：DeepSeek，国内可直连。海外部署可改为 gemini-* 各档（需配 GEMINI_API_KEY）。
DEFAULT_MODEL=deepseek-chat

# Google Gemini API Key — 仅海外/可选；大陆部署请使用 DeepSeek 等国内模型。
# Google Gemini is not reachable/compliant in mainland China, so leave this
# empty for China deployments; the Gemini models then show as unavailable
# (greyed out) in the in-app model picker.
GEMINI_API_KEY=""

# DeepSeek API Key (the default model in mainland-China deployments)
# Get one at https://platform.deepseek.com/api_keys — leave empty to hide the model.
DEEPSEEK_API_KEY=""

# OpenSubtitles Credentials (Required ONLY if you use download_subtitles.py)
OPENSUBTITLES_API_KEY="your_opensubtitles_api_key_here"
OPENSUBTITLES_USERNAME="your_username_here"
OPENSUBTITLES_PASSWORD="your_password_here"

# --- Optional: public deployment hardening ---
# Comma-separated allowed CORS origins (default "*" for local use)
# CORS_ORIGINS=https://your-frontend.example.com
# When set, all /api requests must send a matching X-API-Key header.
# ⚠️ WARNING: it also covers /api/auth/* — browser logins will be rejected (401).
# For public multi-user browser deployments leave this EMPTY. Do not put the
# key into VITE_API_KEY either: that ships the secret to every visitor.
# Only consider it for mobile / internal clients without a browser UI
# (and set BROWSER_UI=0 there to silence the startup warning).
# API_AUTH_KEY=

# BROWSER_UI: 1 (default) = browser UI is served; 0 = mobile/internal clients,
# so a non-empty API_AUTH_KEY is intentional and the startup warning is skipped.
# BROWSER_UI=0

# --- Streaming (SSE) ---
# Interval in seconds between `: ping` heartbeat comment lines on long SSE
# responses. Proxies drop idle connections (Nginx 60s / Cloudflare 100s);
# 15s default is safe. Override only if a proxy has a shorter idle timeout.
# SSE_HEARTBEAT_INTERVAL=15

# --- User accounts / per-user data (optional overrides) ---
# Session cookie gains the Secure flag when set to 1 (required on HTTPS);
# keep it unset/0 for local plain-HTTP development.
# COOKIE_SECURE=1
# Admin emails for the read-only stop-the-bleed dashboard (/api/admin/*).
# Comma-separated, case-insensitive; empty = no admins (all admin endpoints 403).
# Restart the backend after changing it (read once at startup).
# ADMIN_EMAILS=you@example.com

# --- Registration gate (G1 invite-only beta, specs/032) ---
# false (default) = public signup is closed; a valid invite code is required.
# true = G2 open signup (invite code optional, but an invalid supplied code is
# still rejected). Read once at startup; restart after changing.
# REGISTRATION_OPEN=false
# INVITE_SIGNUP_ENABLED=true
# Set both to false to disable all new account creation (login keeps working).
# Defaults used by POST /api/admin/invites when the admin leaves fields empty.
# INVITE_CODE_TTL_DAYS=30
# INVITE_CODE_MAX_USES=1
# Optional server-side pepper for HMAC-SHA256(code). The database still stores
# only a SHA-256 digest, never plaintext. Rotating it invalidates every existing
# code, so generate a long random value once:
#   openssl rand -hex 32
# INVITE_CODE_PEPPER=

# --- Balance & AI billing (M3a, specs/034) ---
# All money is stored as INTEGER micro-USD (1 USD = 1,000,000 uUSD). New accounts
# receive SIGNUP_BONUS_MICRO_USD (default $2.00 = 2000000); admins top up manually.
# 0 = no signup bonus.
# SIGNUP_BONUS_MICRO_USD=2000000
# Per-operation admin top-up/deduct cap (default $100 = 100000000 uUSD).
# MAX_ADMIN_BALANCE_DELTA_MICRO_USD=100000000
# Reserve = (prompt tokens + feature output cap) x highest candidate price x (1+margin%).
# BILLING_RESERVE_MARGIN_PERCENT=20
# Hard cap for a single reserve (default $0.50 = 500000 uUSD); settlement still
# charges actual usage and may overrun the hold.
# BILLING_MAX_RESERVE_MICRO_USD=500000
# Hold lease seconds; stale active holds are expired (crash recovery).
# BILLING_HOLD_TTL_SECONDS=1800
# 1 = raise when settlement write fails (default 0: keep the hold active, log an
# error and retry later so the user still gets the model output).
# BILLING_STRICT=0

# SQLite database for users + sessions (default: data/app.db)
# AUTH_DB_PATH=/absolute/path/to/app.db
# Per-user data root (default: data/users/<user_id>/)
# USER_DATA_DIR=/absolute/path/to/users
# Account data-export temp dir (default: data/exports/<user_id>/; 24h TTL)
# EXPORTS_DIR=/absolute/path/to/exports
# Export ZIP size cap in bytes (default 200MB) and temp-file TTL hours
# EXPORT_MAX_BYTES=209715200
# EXPORT_TTL_HOURS=24

# Whisper model size for the optional no-captions ASR fallback (tiny/base/small/medium)
# WHISPER_MODEL=base

# Opt-in public tunnel in start_app.command (REQUIRES API_AUTH_KEY to be set)
# ENABLE_TUNNEL=1
# TUNNEL_SUBDOMAIN=my-app

# Qwen (Alibaba DashScope, OpenAI-compatible). Required for the default
# Vietnamese route; set the endpoint for the region you use (international
# station: https://dashscope-intl.aliyuncs.com/compatible-mode/v1;
# mainland station: https://dashscope.aliyuncs.com/compatible-mode/v1).
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=sk-...
# Per-language model routes (comma separated; unset keys are skipped).
# MODEL_ROUTE_ZH_CN=deepseek-chat,gemini-2.5-flash
# MODEL_ROUTE_VI_VN=qwen-flash,qwen-plus,deepseek-chat

# --- Feishu alerts (M5, specs/035-feishu-alerts) ---
# 默认关闭。告警只发到一个飞书群的自定义机器人；webhook 本身是密钥，
# 只放本机 .env（权限 600），不要提交、不要写进文档/截图/前端。
# 开启步骤：群设置 → 添加机器人 → 自定义机器人 → 复制 webhook（可选签名密钥）。
# FEISHU_ALERTS_ENABLED=false
# FEISHU_WEBHOOK_URL=
# FEISHU_WEBHOOK_SECRET=
# Minimum level to send: P2 (all, default) / P1 (P0+P1) / P0 (only P0).
# FEISHU_ALERT_LEVEL=P2
# P0 @ owner: Feishu open_id (ou_xxx) or "all"; empty = no mention.
# FEISHU_AT_USER_ID=
# Message format: text (default) / card (rich interactive card).
# FEISHU_ALERT_MESSAGE_FORMAT=text
# Send timeout seconds (default 5, clamped 3-5); never blocks requests.
# FEISHU_ALERT_TIMEOUT_SECONDS=5
# Dedupe window per event+key (seconds; 0 disables) and P1 aggregate window.
# ALERT_DEDUPE_SECONDS=300
# ALERT_P1_AGGREGATE_SECONDS=900
# Environment label in messages and local hour for the P2 daily digest.
# ALERT_ENV=dev
# ALERT_DAILY_DIGEST_HOUR=9
# Per-admin rate limit for POST /api/admin/alerts/test (requests/minute).
# RATE_LIMIT_ADMIN_ALERT_TEST_PER_MINUTE=3
#
# Manual checks (no network):
#   backend/venv/bin/python scripts/check-alerts.py --self-test
#   backend/venv/bin/python scripts/check-alerts.py --dry-run
# Real send test (needs an admin session cookie):
#   curl -X POST http://127.0.0.1:8000/api/admin/alerts/test \
#        -H 'Content-Type: application/json' -d '{"level":"P1"}' -b cookies.txt

# --- Production deployment (M6a) ---
# This file is the local-development template. For production use
#   deploy/production.env.example  (site-specific: linguatrekai.online)
# and follow docs/部署执行手册-linguatrekai.online.md.
# Production must explicitly set / verify:
#   DOMAIN, CORS_ORIGINS=https://linguatrekai.online, COOKIE_SECURE=1,
#   ADMIN_EMAILS, EVENTS_PSEUDONYM_SALT, INVITE_CODE_PEPPER,
#   REGISTRATION_OPEN=false, INVITE_SIGNUP_ENABLED=true,
#   SIGNUP_BONUS_MICRO_USD=2000000,
#   MODEL_ROUTE_ZH_CN / MODEL_ROUTE_VI_VN (code reads MODEL_ROUTE_<LANG>,
#   there is no single MODEL_ROUTES variable).
# Never set API_AUTH_KEY or VITE_API_KEY for the public browser deployment.
