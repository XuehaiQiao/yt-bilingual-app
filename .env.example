# Default LLM for translation / summary / dictionary.
# Must be an id present in backend/config.py MODEL_CATALOG; empty or unknown
# values fall back to "deepseek-chat" (only a warning is printed).
# 默认模型：DeepSeek，国内可直连。海外部署可改为 gemini-* 各档（需配 GEMINI_API_KEY）。
DEFAULT_MODEL=deepseek-chat

# Google Gemini API Key — 仅海外/可选；大陆部署请使用 DeepSeek 等国内模型。
# Google Gemini is not reachable/compliant in mainland China, so leave this
# empty for China deployments; the Gemini models then show as unavailable
# (greyed out) in the in-app model picker.
GEMINI_API_KEY=""

# DeepSeek API Key (the default model in mainland-China deployments)
# Get one at https://platform.deepseek.com/api_keys — leave empty to hide the model.
DEEPSEEK_API_KEY=""

# OpenSubtitles Credentials (Required ONLY if you use download_subtitles.py)
OPENSUBTITLES_API_KEY="your_opensubtitles_api_key_here"
OPENSUBTITLES_USERNAME="your_username_here"
OPENSUBTITLES_PASSWORD="your_password_here"

# --- Optional: public deployment hardening ---
# Comma-separated allowed CORS origins (default "*" for local use)
# CORS_ORIGINS=https://your-frontend.example.com
# When set, all /api requests must send a matching X-API-Key header.
# ⚠️ WARNING: it also covers /api/auth/* — browser logins will be rejected (401).
# For public multi-user browser deployments leave this EMPTY. Do not put the
# key into VITE_API_KEY either: that ships the secret to every visitor.
# Only consider it for mobile / internal clients without a browser UI
# (and set BROWSER_UI=0 there to silence the startup warning).
# API_AUTH_KEY=

# BROWSER_UI: 1 (default) = browser UI is served; 0 = mobile/internal clients,
# so a non-empty API_AUTH_KEY is intentional and the startup warning is skipped.
# BROWSER_UI=0

# --- Streaming (SSE) ---
# Interval in seconds between `: ping` heartbeat comment lines on long SSE
# responses. Proxies drop idle connections (Nginx 60s / Cloudflare 100s);
# 15s default is safe. Override only if a proxy has a shorter idle timeout.
# SSE_HEARTBEAT_INTERVAL=15

# --- User accounts / per-user data (optional overrides) ---
# Session cookie gains the Secure flag when set to 1 (required on HTTPS);
# keep it unset/0 for local plain-HTTP development.
# COOKIE_SECURE=1
# SQLite database for users + sessions (default: data/app.db)
# AUTH_DB_PATH=/absolute/path/to/app.db
# Per-user data root (default: data/users/<user_id>/)
# USER_DATA_DIR=/absolute/path/to/users

# Whisper model size for the optional no-captions ASR fallback (tiny/base/small/medium)
# WHISPER_MODEL=base

# Opt-in public tunnel in start_app.command (REQUIRES API_AUTH_KEY to be set)
# ENABLE_TUNNEL=1
# TUNNEL_SUBDOMAIN=my-app
